-- EXTREME VISUAL OVERRIDE + HARD GRAY SKY + QUALITY LV2
-- Safe client-only LocalScript for Blox Fruits or any Roblox game

local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Terrain = Workspace:FindFirstChildOfClass("Terrain")

local GRAY = Color3.fromRGB(128,128,128)
local AMBIENT_GRAY = Color3.fromRGB(140,140,140)
local SKY_NAME = "_ForcedGraySky"

local lastHeavy = 0
local HEAVY_LOOP_INTERVAL = 1.5  -- seconds

-------------------------------------------------------
-- 1) HARD GRAY SKY ENFORCEMENT
-------------------------------------------------------
local function enforceGraySky()
    -- Remove any other sky objects
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Sky") and child.Name ~= SKY_NAME then
            child:Destroy()
        end
    end

    -- Create or reuse forced gray sky
    local sky = Lighting:FindFirstChild(SKY_NAME)
    if not sky then
        sky = Instance.new("Sky")
        sky.Name = SKY_NAME
        sky.Parent = Lighting
    end

    -- Remove all textures (no sun, moon, stars, clouds)
    sky.SkyboxBk = ""
    sky.SkyboxDn = ""
    sky.SkyboxFt = ""
    sky.SkyboxLf = ""
    sky.SkyboxRt = ""
    sky.SkyboxUp = ""
    sky.SkyboxTintColor = GRAY
    sky.CelestialBodiesShown = false
    sky.StarCount = 0
end

Lighting.ChildAdded:Connect(function()
    task.defer(enforceGraySky)
end)

-------------------------------------------------------
-- 2) LIGHTING SIMPLIFICATION
-------------------------------------------------------
local function enforceLighting()
    Lighting.FogStart = 1e9
    Lighting.FogEnd = 1e9
    Lighting.FogColor = GRAY

    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") or obj:IsA("PostEffect") then
            obj:Destroy()
        end
    end

    Lighting.Brightness = 1
    Lighting.Ambient = AMBIENT_GRAY
    Lighting.OutdoorAmbient = AMBIENT_GRAY
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0

    Lighting.ColorShift_Top = GRAY
    Lighting.ColorShift_Bottom = GRAY
    Lighting.GlobalShadows = false
    Lighting.ShadowSoftness = 0
end

-------------------------------------------------------
-- 3) TERRAIN SIMPLIFICATION
-------------------------------------------------------
local function enforceTerrain()
    if Terrain then
        pcall(function() Terrain.Decoration = false end)
        Terrain.WaterWaveSize = 0
        Terrain.WaterWaveSpeed = 0
        Terrain.WaterTransparency = 1
        Terrain.WaterReflectance = 0
    end
end

-------------------------------------------------------
-- 4) EFFECT QUALITY REDUCTION
-------------------------------------------------------
local function simplifyEffect(obj)
    if obj:IsA("ParticleEmitter") then
        obj.Rate = 0
        obj.Speed = NumberRange.new(0)
        obj.Lifetime = NumberRange.new(0)
        obj.Size = NumberSequence.new(0)
        obj.LightEmission = 0
        obj.LightInfluence = 0
        obj.Transparency = NumberSequence.new(1)
    elseif obj:IsA("Beam") then
        obj.Enabled = false
        obj.Width0 = 0
        obj.Width1 = 0
        obj.LightEmission = 0
        obj.LightInfluence = 0
    elseif obj:IsA("Trail") then
        obj.Enabled = false
        obj.Lifetime = 0
        obj.Transparency = NumberSequence.new(1)
        obj.WidthScale = NumberSequence.new(0)
        obj.LightEmission = 0
    elseif obj:IsA("Explosion") then
        obj.BlastPressure = 0
        obj.BlastRadius = 0
        obj.Visible = false
    elseif obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
        obj.Enabled = false
    end
end

-------------------------------------------------------
-- 5) HEAVY WORLD SIMPLIFICATION
-------------------------------------------------------
local function heavySimplify()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        simplifyEffect(obj)

        if obj:IsA("MeshPart") then
            obj.TextureID = ""
        elseif obj:IsA("SpecialMesh") then
            obj.TextureId = ""
        end

        if obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        end

        if obj:IsA("Part") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0

            local sa = obj:FindFirstChildOfClass("SurfaceAppearance")
            if sa then sa:Destroy() end
        end
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        simplifyEffect(obj)
        if obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency = 1 end
        if obj:IsA("MeshPart") then obj.TextureID = "" end
        if obj:IsA("SpecialMesh") then obj.TextureId = "" end
        if obj:IsA("Part") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
        end
    end)
end)

-------------------------------------------------------
-- 6) FORCE RENDER QUALITY LEVEL 2
-------------------------------------------------------
local function forceLowQuality()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.SavedQualityLevel.Level02
    end)
end

-------------------------------------------------------
-- 7) MAIN LOOP
-------------------------------------------------------
RunService.RenderStepped:Connect(function(dt)
    enforceGraySky()
    enforceLighting()
    enforceTerrain()
    forceLowQuality()

    lastHeavy += dt
    if lastHeavy >= HEAVY_LOOP_INTERVAL then
        lastHeavy = 0
        heavySimplify()
    end
end)

-- Initial enforcement
heavySimplify()
enforceTerrain()
enforceLighting()
enforceGraySky()
forceLowQuality()

print("[EXTREME MODE + HARD GRAY SKY + QUALITY LEVEL 2] ACTIVE")
