-- Client-only visual assist system (legal version)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function applyCircle(character)
    if character == nil then return end
    if character:FindFirstChild("HumanoidRootPart") == nil then return end

    local hrp = character.HumanoidRootPart

    -- Remove existing circles
    local old = hrp:FindFirstChild("VisibilityCircle")
    if old then old:Destroy() end

    -- Create red neon circle
    local circle = Instance.new("BillboardGui")
    circle.Name = "VisibilityCircle"
    circle.Size = UDim2.new(5,0,5,0)  -- size of circle
    circle.AlwaysOnTop = true

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1,0,1,0)
    frame.BackgroundColor3 = Color3.fromRGB(150,0,0) -- deep red
    frame.BorderSizePixel = 0
    frame.BackgroundTransparency = 0
    frame.Parent = circle

    -- Make it a circle
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(1,0)
    uiCorner.Parent = frame

    circle.Parent = hrp
end

local function setupPlayer(plr)
    if plr == LocalPlayer then return end -- don't modify yourself

    plr.CharacterAdded:Connect(function(char)
        applyCircle(char)
    end)

    if plr.Character then
        applyCircle(plr.Character)
    end
end

for _, plr in pairs(Players:GetPlayers()) do
    setupPlayer(plr)
end

Players.PlayerAdded:Connect(setupPlayer)
